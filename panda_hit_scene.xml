<mujoco model="panda_impedance_intercept">
    <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>

    <!-- Include path from the project root -->
    <include file="mujoco_menagerie/franka_emika_panda/panda.xml"/>

    <visual>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="120" elevation="-20"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
        <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
        <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
    </asset>

    <worldbody>
        <light pos="0 0 3" dir="0 0 -1" directional="true"/>
        <geom name="floor" size="0 0 0.05" type="plane" material="grid" condim="3"/>

        <body name="robot_base_pedestal" pos="0 0 0.5">
            <geom type="cylinder" size="0.15 0.5" rgba="0.2 0.2 0.2 1"/>
        </body>

        <body name="target_ball" pos="1.5 0.0 2.0">
            <freejoint name="ball_freejoint"/>
            <geom type="sphere" size="0.05" mass="0.15" rgba="0.9 0.2 0.2 1" friction="0.4"/>
        </body>
    </worldbody>

    <contact>
        <exclude body1="target_ball" body2="link0"/>
    </contact>
</mujoco>